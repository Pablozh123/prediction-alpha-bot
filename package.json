{
  "name": "prediction-alpha-bot",
  "version": "0.1.0",
  "description": "Paper-only prediction market scanner skeleton.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:once": "tsx src/index.ts --once",
    "metrics:dev": "tsx src/index.ts",
    "db:inspect": "tsx src/scripts/inspectDb.ts",
    "paper:report": "tsx src/scripts/paperReport.ts",
    "basket:backfill": "tsx src/scripts/backfillBasketTelemetry.ts",
    "basket:replay": "tsx src/scripts/basketForwardReplayReport.ts",
    "forward:replay": "tsx src/scripts/forwardReplayReport.ts",
    "neg-risk:diagnose": "tsx src/scripts/negRiskDiagnostics.ts",
    "neg-risk:classify": "tsx src/scripts/negRiskClassificationReport.ts",
    "historical:feasibility": "tsx src/scripts/historicalDataFeasibility.ts",
    "snapshots:once": "tsx src/scripts/orderbookSnapshots.ts",
    "telegram:setup": "tsx src/scripts/telegramSetup.ts",
    "telegram:test": "tsx src/scripts/telegramTest.ts",
    "telegram:daily": "tsx src/scripts/dailyTelegramReport.ts",
    "sports:feed": "tsx src/scripts/sportsFeedRecorder.ts",
    "sports:resolution:once": "tsx src/scripts/sportsResolutionOnce.ts",
    "sports:watch": "tsx src/scripts/sportsWatch.ts",
    "sports:report": "tsx src/scripts/sportsResolutionReport.ts",
    "crossvenue:scan": "tsx src/scripts/crossVenueArbScan.ts",
    "crossvenue:dashboard": "tsx src/scripts/crossVenueArbScan.ts --dry-run --auto-discover",
    "crossvenue:serve": "tsx src/scripts/crossVenueDashboardRuntime.ts",
    "oddpool:reference": "tsx src/scripts/oddpoolReference.ts",
    "paper:resolve": "tsx src/execution/paperResolution.ts",
    "paper:resolve:batch": "tsx src/execution/paperResolution.ts --batch",
    "paper:backfill-links": "tsx src/scripts/backfillPaperTradeLinks.ts",
    "strategy:evaluate": "tsx src/scripts/strategyEvaluation.ts",
    "feed:fixture": "tsx src/scripts/arbScanFixture.ts",
    "coverage:report": "tsx src/scripts/coverageReport.ts",
    "forward:clean:start": "tsx src/scripts/cleanForwardRun.ts start",
    "forward:clean:status": "tsx src/scripts/cleanForwardRun.ts status",
    "forward:clean:report": "tsx src/scripts/cleanForwardRun.ts report",
    "reconcile:once": "tsx src/execution/reconciliation.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "latest",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "uuid": "latest",
    "ws": "^8.21.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/ws": "^8.18.1",
    "eslint": "latest",
    "prettier": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
