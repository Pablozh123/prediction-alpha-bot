# Paper-only runtime settings. Copy to .env locally if needed.
# Never put real private keys, seed phrases, or live trading secrets here.

NODE_ENV=development
PAPER_ONLY=true
LOG_LEVEL=info
DATABASE_PATH=./logs/trades.db
SCAN_INTERVAL_MS=30000
FAST_SCAN_ENABLED=true
FAST_SCAN_INTERVAL_MS=10000
RUN_ONCE=false
# MAX_SCAN_CYCLES=
PAPER_FIRE_COOLDOWN_MS=21600000
MAX_SHORT_ARB_DURATION_HOURS=72
CLEAN_BASKET_FILTER_ENABLED=true
CLEAN_BASKET_MIN_EDGE_BPS=100
CLEAN_BASKET_MIN_ROI_BPS=100
CLEAN_BASKET_MIN_MAX_POSITIVE_COST_USD=100
CLEAN_BASKET_MIN_LEG_DEPTH_USD=100
CLEAN_BASKET_MAX_LEG_SPREAD_BPS=250
# Capital each paper basket targets; the book decides what it actually gets.
PAPER_TARGET_SIZE_USD=20
# Baskets whose executable capital is below this are journaled but not chances.
MIN_EXECUTABLE_DEPTH_USD=5
# Fee pricing of legs: "taker" (every leg aggressive, conservative default) or
# "maker_first" (the leg with the highest taker fee rests as a limit order).
EXECUTION_ROLE_MODE=taker
# Hurdle rate: annualised net return in percent a structural basket must clear
# to count as a chance or a carry candidate (docs/ARB_TAXONOMY.md, E1). The
# market prices locked collateral at roughly 3 to 7 percent a year; below the
# hurdle a gap is a funding premium, not an edge. Started at 10, lowered to 5
# on 2026-09-05 so the carry band stays visible. Published in the feed.
MIN_ANNUALIZED_NET_PCT=5
# Website feed: directory that receives arb_scan.json after every cycle.
# Unset = nothing is published (logged once at startup). Use a path outside
# the repo, e.g. the website's public data folder.
# ARB_PUBLISH_DIR=
ARB_PUBLISH_INTERVAL_MS=300000
# Resolve open paper trades against Gamma outcomes inside the loop.
PAPER_RESOLVE_ENABLED=true
PAPER_RESOLVE_INTERVAL_MS=1800000
# Cross-venue lane inside the loop (never paper-fires; pairs stay unverified).
CROSS_VENUE_SCAN_ENABLED=true
CROSS_VENUE_SCAN_INTERVAL_MS=300000
ORDERBOOK_SNAPSHOT_ENABLED=false
ORDERBOOK_SNAPSHOT_INTERVAL_MS=300000
ORDERBOOK_SNAPSHOT_TOKEN_LIMIT=160
ORDERBOOK_SNAPSHOT_GAMMA_EVENT_LIMIT=400
ORDERBOOK_SNAPSHOT_MAX_TOKENS_PER_MARKET=16
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-local-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-local-telegram-chat-id
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_DAILY_REPORT_ENABLED=false
TELEGRAM_DAILY_REPORT_INTERVAL_MS=86400000
TELEGRAM_DAILY_REPORT_ON_START=false
TELEGRAM_DAILY_REPORT_WINDOW_HOURS=24
SPORTS_RESOLUTION_INTERVAL_MS=30000
SPORTS_PAPER_FIRE_ENABLED=false
CROSS_VENUE_PAIRS_PATH=./config/crossVenuePairs.json
CROSS_VENUE_AUTO_DISCOVER=true
CROSS_VENUE_GAMMA_LIMIT=200
CROSS_VENUE_KALSHI_LIMIT=200
CROSS_VENUE_KALSHI_MAX_PAGES=1
CROSS_VENUE_MAX_PAIRS=25
CROSS_VENUE_MIN_MATCH_SCORE=0.68
CROSS_VENUE_MIN_NET_CENTS=0.5
# Fees default to the venue curves (docs/CROSS_VENUE_ARB.md, schedule
# 2026-07-30). Flat cents per share are a legacy override and are only used
# when set to a positive value; zero is ignored.
# CROSS_VENUE_KALSHI_FEE_CENTS=
# CROSS_VENUE_POLYMARKET_FEE_CENTS=
CROSS_VENUE_DASHBOARD_HOST=127.0.0.1
CROSS_VENUE_DASHBOARD_PORT=8787
CROSS_VENUE_ORDERBOOK_CACHE_MAX_AGE_MS=15000
CROSS_VENUE_POLYMARKET_WS=false
ODDPOOL_API_KEY=paste_your_oddpool_key_here
