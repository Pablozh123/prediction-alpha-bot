# Paper-only runtime settings. Copy to .env locally if needed.
# Never put real private keys, seed phrases, or live trading secrets here.

NODE_ENV=development
PAPER_ONLY=true
LOG_LEVEL=info
DATABASE_PATH=./logs/trades.db
SCAN_INTERVAL_MS=30000
RUN_ONCE=false
# MAX_SCAN_CYCLES=
PAPER_FIRE_COOLDOWN_MS=21600000
